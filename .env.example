# Server
PORT=4173
# Local default is 127.0.0.1. A managed host (Render, Fly, Docker) needs 0.0.0.0;
# leave HOST unset there and the server picks 0.0.0.0 when RENDER or NODE_ENV=production is set.
HOST=127.0.0.1
# On a platform with an ephemeral filesystem, use a guaranteed-writable path: /tmp/agentproof.db
AGENTPROOF_DB_PATH=./data/agentproof.db

# simulator (default) or razorpay_test
PAYMENT_ADAPTER=simulator

# Exact-match allow-list for cross-origin API callers, comma-separated, no trailing slash.
# Only needed when the frontend is hosted separately (e.g. Vercel) from this API.
# Unset means same-origin only: the API never returns a wildcard CORS header.
ALLOWED_ORIGINS=

# This deployment's own public URL. Used for readable startup logs and docs links.
PUBLIC_ORIGIN=

# Build-time only, read by Vite into the frontend bundle. Empty means same-origin
# (single Node service, or the Vite dev proxy). Set it to the API origin when the
# static frontend is deployed apart from the API, e.g. https://agentproof.onrender.com
VITE_API_BASE_URL=

# Optional Razorpay test-mode integration. Never use live credentials here.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me

# Optional OpenAI-compatible model used only to generate new adversarial cases.
# The seeded 60-case evaluation and guided demo work fully offline.
AGENTPROOF_LLM_BASE_URL=
AGENTPROOF_LLM_API_KEY=
AGENTPROOF_LLM_MODEL=
