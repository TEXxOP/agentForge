{
  "name": "agentproof",
  "version": "0.1.0",
  "private": true,
  "description": "Safety testing and runtime policy enforcement for action-taking AI agents.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "npm run build && node server.mjs",
    "serve": "node server.mjs",
    "dev:api": "node --watch server.mjs",
    "dev:web": "vite --config vite.config.js",
    "build": "vite build --config vite.config.js",
    "test": "node --test --test-reporter=spec",
    "check": "npm run build && node --check server.mjs && node --test --test-reporter=spec"
  },
  "keywords": [
    "ai-agents",
    "guardrails",
    "payments",
    "agent-evaluation",
    "razorpay"
  ],
  "license": "MIT",
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "lucide-react": "^1.37.0",
    "motion": "^13.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.2.2"
  }
}
